# TEMPLATE ONLY. Generate and install the real unit with
#
#   bash deploy/install-service.sh
#
# which fills in User, Group, WorkingDirectory, PYTHONPATH and ExecStart for the
# invoking user and this checkout, then enables it at boot.
#
# Starts the cane at boot and restarts it if it ever stops. No network needed.
# The values below assume /home/pi/capstone-pi-benchmarking; edit them only if
# you install this file by hand.
[Unit]
Description=Smart assistive cane (sensors, vision, haptics)
After=multi-user.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=i2c gpio video
WorkingDirectory=/home/pi/capstone-pi-benchmarking
Environment=PYTHONPATH=/home/pi/capstone-pi-benchmarking/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/capstone-pi-benchmarking/.venv/bin/python -m yolo_pi.cane --config configs/cane-hardware.json run
Restart=always
RestartSec=3
# SIGTERM makes the runtime stop the motors and release the camera; give it time.
TimeoutStopSec=10
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
